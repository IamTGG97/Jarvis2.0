DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jarvis2
DB_USER=jarvis_app
DB_PASSWORD=replace_with_your_local_password
# Seconds to wait for PostgreSQL; one automatic retry follows a timeout.
DB_CONNECT_TIMEOUT=10
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# "0" unloads the chat model after every answer (saves ~1 GB RAM, costs ~4-5 s
# reload per answer). Use e.g. 5m only if the machine has spare memory.
OLLAMA_KEEP_ALIVE=0
# Optional sampling temperature; blank uses the model's default.
OLLAMA_TEMPERATURE=
# Semantic memory search (hybrid keyword + embeddings). "off" = keyword only.
MEMORY_EMBEDDINGS=on
OLLAMA_EMBED_MODEL=nomic-embed-text
# "0" unloads the embedding model after each call so it never shares RAM with
# the chat model; costs ~2 s per cold embedding on a 2-core CPU.
OLLAMA_EMBED_KEEP_ALIVE=0
OLLAMA_EMBED_TIMEOUT_SECONDS=30
WHISPER_MODEL=tiny.en
