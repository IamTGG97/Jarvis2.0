DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jarvis2
DB_USER=jarvis_app
DB_PASSWORD=replace_with_your_local_password
# Seconds to wait for PostgreSQL; one automatic retry follows a timeout.
DB_CONNECT_TIMEOUT=10
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# "0" unloads the chat model after every answer (saves ~1 GB RAM, costs ~4-5 s
# reload per answer). Use e.g. 5m only if the machine has spare memory.
OLLAMA_KEEP_ALIVE=0
# Optional sampling temperature; blank uses the model's default.
OLLAMA_TEMPERATURE=
# Semantic memory search (hybrid keyword + embeddings). "off" = keyword only.
MEMORY_EMBEDDINGS=on
OLLAMA_EMBED_MODEL=nomic-embed-text
# "0" unloads the embedding model after each call so it never shares RAM with
# the chat model; costs ~2 s per cold embedding on a 2-core CPU.
OLLAMA_EMBED_KEEP_ALIVE=0
OLLAMA_EMBED_TIMEOUT_SECONDS=30
# Optional retention: delete conversations idle for this many days. Blank or 0
# keeps everything (default). Checked at startup and every N hours.
MEMORY_RETENTION_DAYS=
MEMORY_RETENTION_CHECK_HOURS=6
WHISPER_MODEL=tiny.en
# Object detection (POST /api/detect). Weights: backend\download_vision_model.py
# yolox_tiny (default, ~65 MB RAM, ~0.1-0.2 s/frame) or yolox_nano (lighter, less accurate).
VISION_MODEL=yolox_tiny
# Minimum detection confidence (0-1).
VISION_CONFIDENCE=0.35
# CPU threads for the detector.
VISION_THREADS=2
# Blank = backend/models (git-ignored).
VISION_MODELS_DIR=
# "off" unloads the detector after every request: ~45 MB less RAM between
# frames, ~+0.1 s per request. Default keeps it loaded (~75 MB).
VISION_KEEP_LOADED=on
# Vision-language model for color/text/brand/comparison questions
# (POST /api/respond/vision). Ollama tag; moondream is Apache-2.0. Benchmark:
# docs/overnight/phase4-vlm-benchmark.md. (Not VISION_MODEL: that is the detector.)
VLM_MODEL=moondream
# "0" unloads the VLM after every answer so it never shares RAM with qwen.
VLM_KEEP_ALIVE=0
# Give up on the VLM after this many seconds (it can take minutes on 2 cores
# when RAM is short). Jarvis then says the close look failed.
VLM_TIMEOUT_SECONDS=180
# Longest image edge sent to the VLM, and the answer length limit in tokens.
VLM_MAX_IMAGE_EDGE=768
VLM_NUM_PREDICT=80
